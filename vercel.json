{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "git": {
    "deploymentEnabled": {
      "feat/**": false,
      "fix/**": false,
      "chore/**": false,
      "perf/**": false,
      "test/**": false
    }
  },
  "headers": [
    {
      "source": "/api/status",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ]
}
